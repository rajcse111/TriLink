# =============================================
# APPLICATION
# =============================================
NODE_ENV=development
PORT=3000
APP_NAME="TriLink Referral Network"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# =============================================
# DATABASE (PostgreSQL)
# =============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trilink_referral
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# =============================================
# REDIS
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================
# JWT
# =============================================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# =============================================
# OTP
# =============================================
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# =============================================
# EMAIL (SMTP)
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="TriLink Network <noreply@trilink.com>"

# =============================================
# SMS / WhatsApp OTP  (pick ONE provider)
# =============================================
# Leave SMS_PROVIDER unset → OTPs are only logged (dev mode)

# --- Option A: Twilio WhatsApp sandbox (FREE for testing) ---
# 1. Sign up free at twilio.com
# 2. Go to Messaging → Try WhatsApp → follow join instructions
# 3. Users must text "join <sandbox-keyword>" to +14155238886 once
# SMS_PROVIDER=twilio_whatsapp
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Option B: Twilio SMS (free trial credit ~$15) ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# --- Option C: Fast2SMS (free credits for Indian numbers) ---
# Sign up at fast2sms.com → Dashboard → Dev API
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_fast2sms_api_key

# =============================================
# PAYMENT GATEWAY (Razorpay) — disabled for Phase 1 local testing
# =============================================
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# =============================================
# FINANCIAL CONFIG
# =============================================
ACTIVATION_FEE=100
LEVEL1_INCOME=40
LEVEL2_INCOME=20
LEVEL3_INCOME=10
LEVEL4_INCOME=5
LEVEL5_INCOME=2
MAX_LEVELS_FOR_INCOME=10
STAGE_COUNT=13

# =============================================
# SCHEDULER
# =============================================
BATCH_PROCESSOR_CRON="0 20 * * *"
BATCH_SIZE=2000

# =============================================
# SECURITY
# =============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12

# =============================================
# FILE UPLOAD
# =============================================
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads
